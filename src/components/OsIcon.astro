---
interface Props { os: 'Linux' | 'Windows' | 'Outro'; }
const { os } = Astro.props;
// SVGs desenhados para este componente. Tux é o mascote criado por Larry Ewing:
// https://commons.wikimedia.org/wiki/File:Tux.svg
// A marca Windows pertence à Microsoft; o símbolo abaixo usa quatro janelas azuis.
---
<svg class="os-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" role="img" aria-label={os}>
  {os === 'Linux' ? (
    <>
      <path fill="#E7A126" stroke="#95621B" stroke-width=".55" d="M8.8 17.8c-2.5-.5-4.8.5-5.8 2.4-.4.7.1 1.5 1 1.5h5.5c1.3 0 1.7-.9 1-1.8l-1.7-2.1Zm6.4 0c2.5-.5 4.8.5 5.8 2.4.4.7-.1 1.5-1 1.5h-5.5c-1.3 0-1.7-.9-1-1.8l1.7-2.1Z"/>
      <path fill="#202427" stroke="#859092" stroke-width=".55" d="M8.1 8.7C5.9 9.2 4.2 12 4.6 14.8c.2 1.5 1.3 3 3.2 3.5l1.9-4.8-1.6-4.8Zm7.8 0c2.2.5 3.9 3.3 3.5 6.1-.2 1.5-1.3 3-3.2 3.5l-1.9-4.8 1.6-4.8Z"/>
      <path fill="#202427" stroke="#859092" stroke-width=".65" d="M12 1.6c-3.2 0-4.6 2.7-4.5 6.5.1 2.5-1.3 4-1.3 7.2 0 3.4 2.2 5.1 5.8 5.1s5.8-1.7 5.8-5.1c0-3.2-1.4-4.7-1.3-7.2.1-3.8-1.3-6.5-4.5-6.5Z"/>
      <ellipse cx="12" cy="14.2" rx="4.2" ry="5.2" fill="#F6F7F2"/>
      <ellipse cx="10.1" cy="6.1" rx="1.35" ry="2" fill="#F6F7F2"/>
      <ellipse cx="13.9" cy="6.1" rx="1.35" ry="2" fill="#F6F7F2"/>
      <ellipse cx="10.5" cy="6.5" rx=".52" ry=".83" fill="#16191B"/>
      <ellipse cx="13.5" cy="6.5" rx=".52" ry=".83" fill="#16191B"/>
      <path fill="#E9A52D" stroke="#A2681C" stroke-width=".45" d="M9.5 8.5c.7-.8 1.5-1.1 2.5-1.1s1.8.3 2.5 1.1L12 10.2 9.5 8.5Z"/>
    </>
  ) : os === 'Windows' ? (
    <g fill="#00A4EF">
      <path d="M2.2 3.3 11 2v9H2.2V3.3ZM12.4 1.8 21.8.5V11h-9.4V1.8ZM2.2 12.4H11v9l-8.8-1.3v-7.7ZM12.4 12.4h9.4v10.5l-9.4-1.3v-9.2Z"/>
    </g>
  ) : (
    <g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="15" rx="2"/><path d="m5 8 3 2-3 2m5 1h4M8 21h8"/></g>
  )}
</svg>
