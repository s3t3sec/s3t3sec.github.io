---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entries: CollectionEntry<'writeups'>[];
  emptyMessage?: string;
}
const { entries, emptyMessage = 'Os write-ups concluídos aparecerão aqui assim que forem publicados.' } = Astro.props;
---
{entries.length > 0 ? (
  <div class="article-list">
    {entries.map((entry) => <a class="article-row" href={`/write-ups/${entry.id}/`}><span>{entry.data.title}</span><small>{entry.data.os} · {entry.data.difficulty}</small><span aria-hidden="true">↗</span></a>)}
  </div>
) : (
  <div class="empty-state"><span class="empty-symbol" aria-hidden="true">&gt;_</span><h2>Nenhum artigo publicado ainda</h2><p>{emptyMessage}</p></div>
)}
