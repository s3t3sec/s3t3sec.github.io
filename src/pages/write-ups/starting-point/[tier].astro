---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleList from '../../../components/ArticleList.astro';
import WriteupCard from '../../../components/WriteupCard.astro';
import { getPublishedWriteupCards, getUpcomingWriteups } from '../../../lib/writeups';
export function getStaticPaths() { return ['0', '1', '2'].map((tier) => ({ params: { tier: `tier-${tier}` }, props: { tier } })); }
const { tier } = Astro.props;
const upcoming = (await getUpcomingWriteups()).filter((entry) => entry.tier === `Tier ${tier}`);
const publishedCards = (await getPublishedWriteupCards()).filter((entry) => entry.category === 'Starting Point' && entry.tier === `Tier ${tier}`);
---
<BaseLayout title={`Tier ${tier}`} description={`Write-ups Starting Point Tier ${tier}.`}>
  <div class="page-intro"><div class="section-kicker">/ write-ups / starting point</div><h1>Tier {tier}<span class="accent">.</span></h1><p class="page-lead">{tier === '0' ? 'Fundamentos e primeiros passos na trilha Starting Point.' : tier === '1' ? 'Máquinas que apresentam serviços, aplicações e caminhos de exploração.' : 'Desafios para conectar enumeração, exploração e escalada de privilégios.'}</p></div>
  <section class="content-section"><div class="section-heading"><div><div class="section-kicker">/ biblioteca</div><h2>Artigos publicados</h2></div></div>{publishedCards.length > 0 ? <div class="card-grid">{publishedCards.map((entry) => <WriteupCard entry={entry} />)}</div> : <ArticleList entries={[]} emptyMessage={`Ainda não há write-ups concluídos no Tier ${tier}.`} />}</section>
  {upcoming.length > 0 && <section class="content-section"><div class="section-heading"><div><div class="section-kicker">/ em andamento</div><h2>Em preparação</h2><p>Estes estudos ainda não estão disponíveis para leitura.</p></div></div><div class="card-grid">{upcoming.map((entry) => <WriteupCard entry={entry} />)}</div></section>}
</BaseLayout>
