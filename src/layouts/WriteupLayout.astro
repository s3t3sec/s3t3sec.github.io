---
import BaseLayout from './BaseLayout.astro';
import MachineInfo from '../components/MachineInfo.astro';
import WriteupImageLightbox from '../components/WriteupImageLightbox.astro';
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';

interface Props {
  entry: CollectionEntry<'writeups'>;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---
<BaseLayout title={entry.data.title} description={entry.data.description}>
  <article class="article-page">
    <header class="writeup-header">
      <div class="section-kicker">/ write-ups</div>
      <MachineInfo data={entry.data} />
    </header>
    <div class:list={['writeup-columns', { 'has-toc': toc.length > 0 }]}>
      <div class="prose article-body writeup-body"><Content /></div>
      {toc.length > 0 && <details class="toc writeup-toc" open><summary>Nesta página</summary><nav aria-label="Nesta página"><ul>{toc.map((heading) => <li class:list={[{ subheading: heading.depth === 3 }]}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ul></nav></details>}
    </div>
  </article>
  <WriteupImageLightbox />
  <script>
    const steps = document.querySelector<HTMLDetailsElement>('.writeup-toc');
    const compactSteps = window.matchMedia('(max-width: 1320px)');
    if (steps) {
      const syncSteps = () => { steps.open = !compactSteps.matches; };
      syncSteps();
      compactSteps.addEventListener('change', syncSteps);
      steps.addEventListener('toggle', () => {
        if (!compactSteps.matches && !steps.open) steps.open = true;
      });
    }
    const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>('.writeup-toc a[href^="#"]')];
    const tocHeadings = tocLinks.map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))));
    if (tocLinks.length > 0) {
      const updateCurrentStep = () => {
        let current = tocHeadings[0];
        tocHeadings.forEach((heading) => {
          if (heading && heading.getBoundingClientRect().top <= 150) current = heading;
        });
        tocLinks.forEach((link, index) => {
          if (tocHeadings[index] === current) link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        });
      };
      window.addEventListener('scroll', updateCurrentStep, { passive: true });
      updateCurrentStep();
    }
    document.querySelectorAll<HTMLElement>('.article-body pre').forEach((block) => {
      const code = block.querySelector('code');
      if (!code) return;
      const wrapper = document.createElement('div');
      wrapper.className = 'code-block';
      block.parentNode?.insertBefore(wrapper, block);
      wrapper.append(block);
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'code-copy';
      button.textContent = 'Copiar';
      button.setAttribute('aria-label', 'Copiar bloco de código');
      wrapper.append(button);
      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(code.textContent ?? '');
          button.textContent = 'Copiado!';
          button.setAttribute('aria-label', 'Código copiado');
          window.setTimeout(() => {
            button.textContent = 'Copiar';
            button.setAttribute('aria-label', 'Copiar bloco de código');
          }, 2200);
        } catch {
          button.textContent = 'Não foi possível copiar';
          window.setTimeout(() => { button.textContent = 'Copiar'; }, 2200);
        }
      });
    });
  </script>
</BaseLayout>
